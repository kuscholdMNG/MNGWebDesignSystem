{
  "name": "mng_web_design_system",
  "version": "0.1.0",
  "description": "MNG Web Design System tokens (DTCG 2025.10) and the ready-to-use files built from them: CSS, Sass, JS/TS, Tailwind v4 and v3, WordPress theme.json, flat JSON.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:kuscholdMNG/mng_web_ds",
  "files": ["dist", "tokens/core", "tokens/themes", "tokens/wordpress"],
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": { "types": "./dist/js/tokens.d.ts", "default": "./dist/js/tokens.js" },
    "./js/tokens.js": { "types": "./dist/js/tokens.d.ts", "default": "./dist/js/tokens.js" },
    "./css/*": "./dist/css/*",
    "./scss/*": "./dist/scss/*",
    "./tailwind/theme.css": "./dist/tailwind/theme.css",
    "./tailwind/preset": { "import": "./dist/tailwind/tailwind.preset.js", "require": "./dist/tailwind/tailwind.preset.cjs" },
    "./tailwind/*": "./dist/tailwind/*",
    "./wordpress/*": "./dist/wordpress/*",
    "./json/*": "./dist/json/*",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "sideEffects": ["*.css", "*.scss"],
  "scripts": {
    "build": "python3 scripts/build-tokens/make-tokens.py && python3 scripts/build-tokens/build.py"
  }
}
