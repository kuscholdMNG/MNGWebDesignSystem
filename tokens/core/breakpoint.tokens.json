{
  "$description": "MNG Device breakpoints (core). Min-width boundaries matching the Figma screen widths 340 / 360 / 768 / 1024 / 1280. fold (340) is the smallest supported width. Reader Dashboard today; every product eventually. Production drift: design-vs-production.md entry 28.",
  "breakpoint": {
    "$type": "dimension",
    "fold": {
      "$value": {
        "value": 340,
        "unit": "px"
      },
      "$description": "Fold (narrow and folding phones), 340px and up. The smallest supported width (Karl, 2026-10-14).",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 340
          }
        }
      }
    },
    "mobile": {
      "$value": {
        "value": 360,
        "unit": "px"
      },
      "$description": "Mobile, 360px and up.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 360
          }
        }
      }
    },
    "tablet": {
      "$value": {
        "value": 768,
        "unit": "px"
      },
      "$description": "Tablet (vertical), 768px and up.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 768
          }
        }
      }
    },
    "tablet-landscape": {
      "$value": {
        "value": 1024,
        "unit": "px"
      },
      "$description": "Tablet horizontal, 1024px and up. Reader Dashboard's layout switches here.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 1024
          }
        }
      }
    },
    "desktop": {
      "$value": {
        "value": 1280,
        "unit": "px"
      },
      "$description": "Desktop, 1280px and up.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "frameWidth": 1280
          }
        }
      }
    }
  }
}
