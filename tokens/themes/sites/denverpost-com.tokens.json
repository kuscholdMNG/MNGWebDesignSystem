{
  "$description": "The Denver Post (denverpost.com) site overrides on top of Denver Post. Applied inside #page. Generated; never edit by hand.",
  "$extensions": {
    "com.mng": {
      "publication": "The Denver Post",
      "domain": "denverpost.com",
      "exceptions": []
    }
  },
  "color": {
    "$type": "color",
    "theme": {
      "subsite-custom": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 1,
          "hex": "#000000"
        },
        "$description": "Site override (sub-site color set for this site only).",
        "$extensions": {
          "com.mng": {
            "rgba": "rgba(0, 0, 0, 1)",
            "figma": null,
            "siteOverride": true
          }
        }
      }
    }
  }
}
